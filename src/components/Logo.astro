---
/**
 * Logo real de HacksinCodigos.
 *
 * Antes esto era un candado genérico dibujado a mano en SVG que no se parecía a
 * la marca. Ahora usa el archivo original: candado rojo con trazos de circuito y
 * el logotipo en dos líneas, con el fondo negro ya recortado (ver
 * scripts/prepare-assets.mjs) para que se apoye sobre cualquier fondo.
 *
 *   variant="lockup"  candado + texto — navbar y pie de página
 *   variant="mark"    solo el candado — donde el texto no se leería
 */
export interface Props {
  /** Altura en píxeles. El ancho se calcula con la proporción real del archivo. */
  height?: number;
  variant?: 'lockup' | 'mark';
  class?: string;
  /** El logo suele ir dentro de un enlace que ya se describe a sí mismo. */
  alt?: string;
  eager?: boolean;
}

const RATIO = { lockup: 817 / 269, mark: 224 / 269 };

const { height = 36, variant = 'lockup', class: className, alt = '', eager = false } = Astro.props;
const src = variant === 'mark' ? '/images/logo-marca.png' : '/images/logo-hacksincodigos.png';
const width = Math.round(height * RATIO[variant]);
---
<img
  src={src}
  alt={alt}
  width={width}
  height={height}
  class:list={['brand-logo', className]}
  decoding="async"
  loading={eager ? 'eager' : 'lazy'}
  fetchpriority={eager ? 'high' : undefined}
  aria-hidden={alt === '' ? 'true' : undefined}
/>
