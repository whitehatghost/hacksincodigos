---
import { site } from '../data/site';

export interface Props {
  title: string;
  description: string;
  /** Ruta canónica, siempre con barra final. */
  path: string;
  image?: string;
  type?: 'website' | 'article' | 'product';
  noindex?: boolean;
  /** Bloques JSON-LD adicionales para esta página. */
  schemas?: unknown[];
  publishedTime?: string;
  modifiedTime?: string;
}

const {
  title,
  description,
  path,
  image = site.ogImage,
  type = 'website',
  noindex = false,
  schemas = [],
  publishedTime,
  modifiedTime,
} = Astro.props;

const canonical = new URL(path, site.url).href;
const ogImageUrl = new URL(image, site.url).href;
---
<meta charset="utf-8" />
<meta name="viewport" content="width=device-width, initial-scale=1" />

<title>{title}</title>
<meta name="description" content={description} />
<link rel="canonical" href={canonical} />

{
  noindex ? (
    <meta name="robots" content="noindex, follow" />
  ) : (
    <meta
      name="robots"
      content="index, follow, max-snippet:-1, max-video-preview:-1, max-image-preview:large"
    />
  )
}

<meta name="author" content={site.name} />
<meta name="geo.region" content="CR" />
<meta name="geo.placename" content="Costa Rica" />

<!-- Open Graph -->
<meta property="og:locale" content="es_CR" />
<meta property="og:type" content={type} />
<meta property="og:site_name" content={site.name} />
<meta property="og:title" content={title} />
<meta property="og:description" content={description} />
<meta property="og:url" content={canonical} />
<meta property="og:image" content={ogImageUrl} />
<meta property="og:image:width" content="1200" />
<meta property="og:image:height" content="630" />
<meta property="og:image:alt" content={title} />
{publishedTime && <meta property="article:published_time" content={publishedTime} />}
{modifiedTime && <meta property="article:modified_time" content={modifiedTime} />}

<!-- Twitter -->
<meta name="twitter:card" content="summary_large_image" />
<meta name="twitter:title" content={title} />
<meta name="twitter:description" content={description} />
<meta name="twitter:image" content={ogImageUrl} />

<!-- Iconos -->
<link rel="icon" href="/favicon.ico" sizes="32x32" />
<link rel="icon" href="/images/logo-32.png" type="image/png" sizes="32x32" />
<link rel="icon" href="/images/logo-192.png" type="image/png" sizes="192x192" />
<link rel="apple-touch-icon" href="/images/logo-180.png" />
<link rel="manifest" href="/site.webmanifest" />
<meta name="theme-color" content="#0a0a0f" />

<!-- Tipografías autoalojadas: sin peticiones a terceros en la ruta crítica -->
<link rel="preload" href="/fonts/space-grotesk-700.woff2" as="font" type="font/woff2" crossorigin />
<link rel="preload" href="/fonts/inter-400.woff2" as="font" type="font/woff2" crossorigin />

{schemas.map((schema) => (
  <script is:inline type="application/ld+json" set:html={JSON.stringify(schema)} />
))}
