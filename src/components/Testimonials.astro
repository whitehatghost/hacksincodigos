---
import { testimonials } from '../data/content';
---
<section id="testimonios" aria-label="Testimonios">
  <div class="container">
    <h2 class="section-title fade-up" data-i18n="testimonios_title">Lo que dicen nuestros clientes</h2>
    <p class="section-subtitle fade-up" data-i18n="testimonios_sub">Resultados reales de negocios costarricenses</p>
    <div class="carousel-wrapper fade-up">
      <div class="carousel-track" id="carousel-track">
        {testimonials.map((t) => (
          <div class="testimonial-slide">
            <div class="testimonial-card">
              <div class="testimonial-stars" aria-label="5 estrellas">★★★★★</div>
              <p class="testimonial-text" data-i18n={`${t.i18n}_text`}>{t.text}</p>
              <div class="testimonial-author">
                <div class="avatar" style={`background:${t.avatarBg}`} aria-hidden="true">{t.initials}</div>
                <div>
                  <div class="testimonial-name" data-i18n={`${t.i18n}_name`}>{t.name}</div>
                  <div class="testimonial-company" data-i18n={`${t.i18n}_co`}>{t.company}</div>
                </div>
              </div>
            </div>
          </div>
        ))}
      </div>
      <div class="carousel-dots" role="tablist" aria-label="Testimonios">
        {testimonials.map((_, i) => (
          <button
            class:list={['dot', i === 0 && 'active']}
            role="tab"
            aria-selected={i === 0 ? 'true' : 'false'}
            aria-label={`Testimonio ${i + 1}`}
            data-index={String(i)}
          ></button>
        ))}
      </div>
    </div>
  </div>
</section>
