---
import SeoHead from '../components/SeoHead.astro';
import Navbar from '../components/Navbar.astro';
import Footer from '../components/Footer.astro';
import WhatsAppFloat from '../components/WhatsAppFloat.astro';
import ChatAgente from '../components/ChatAgente.astro';
import { organizationSchema, websiteSchema } from '../lib/schema';
import '../styles/fonts.css';
import '../styles/site.css';
import '../styles/pages.css';

export interface Props {
  title: string;
  description: string;
  path: string;
  image?: string;
  type?: 'website' | 'article' | 'product';
  noindex?: boolean;
  schemas?: unknown[];
  /** La home carga el fondo de partículas y la escena 3D; el resto no los necesita. */
  heroEffects?: boolean;
  bodyClass?: string;
  /** es-CR por defecto; las páginas de /en/ declaran en. */
  lang?: 'es-CR' | 'en';
  /** Pares de la misma página en otro idioma, para hreflang. */
  alternates?: { lang: string; path: string }[];
}

const {
  title,
  description,
  path,
  image,
  type,
  noindex,
  schemas = [],
  heroEffects = false,
  bodyClass,
  lang = 'es-CR',
  alternates = [],
} = Astro.props;

// Organization + WebSite van en todas las páginas: le dan a Google una única
// entidad de negocio consistente en todo el sitio.
const allSchemas = [organizationSchema(), websiteSchema(), ...schemas];
---
<!doctype html>
<html lang={lang}>
  <head>
    <SeoHead
      title={title}
      description={description}
      path={path}
      image={image}
      type={type}
      noindex={noindex}
      schemas={allSchemas}
      lang={lang}
      alternates={alternates}
    />
    {heroEffects && (
      <>
        <link rel="preconnect" href="https://cdn.jsdelivr.net" crossorigin />
        <link rel="preconnect" href="https://unpkg.com" crossorigin />
        <link rel="preconnect" href="https://prod.spline.design" crossorigin />
      </>
    )}
  </head>
  <body class={bodyClass}>
    <a class="skip-link" href="#main-content">Saltar al contenido</a>
    <div id="cursor" aria-hidden="true"></div>

    <Navbar />

    <main id="main-content">
      <slot />
    </main>

    <Footer />
    <WhatsAppFloat />
    <ChatAgente />

    {heroEffects && (
      <>
        <script is:inline defer src="https://cdn.jsdelivr.net/npm/tsparticles@2.12.0/tsparticles.bundle.min.js"></script>
        <script is:inline type="module" src="https://unpkg.com/@splinetool/viewer@1.9.82/build/spline-viewer.js"></script>
      </>
    )}

    <script src="../scripts/site.js"></script>
  </body>
</html>
