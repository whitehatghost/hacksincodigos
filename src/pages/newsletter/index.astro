---
/**
 * Página del boletín mensual.
 *
 * Explica qué se manda y con qué frecuencia, que es lo que decide si alguien
 * deja su correo. El componente de alta muestra WhatsApp mientras el envío sea
 * manual, y un formulario si algún día se conecta Zoho Campaigns.
 */
import Base from '../../layouts/Base.astro';
import Breadcrumbs from '../../components/Breadcrumbs.astro';
import NewsletterSignup from '../../components/NewsletterSignup.astro';
import { promesa, ediciones } from '../../data/newsletter';
import { articles } from '../../data/articles';
import { webPageSchema, breadcrumbSchema, faqSchema } from '../../lib/schema';

const path = '/newsletter/';
const title = 'Boletín mensual | HacksinCodigos';
const description =
  'Una vez al mes: lo nuevo que publicamos, un caso real de cliente y una recomendación práctica para tu negocio. Sin spam y con baja cuando quieras.';

const crumbs = [
  { name: 'Inicio', path: '/' },
  { name: 'Boletín', path },
];

const faqs = [
  {
    q: '¿Cada cuánto llega?',
    a: 'Una vez al mes. No mandamos correos sueltos entre ediciones salvo que pase algo que de verdad te afecte, como un cambio en un servicio que ya usás.',
  },
  {
    q: '¿Qué trae cada edición?',
    a: 'Lo nuevo del mes —servicios, artículos y proyectos publicados—, un caso real de un cliente con qué se resolvió, y una recomendación práctica que podés aplicar por tu cuenta sin contratarnos.',
  },
  {
    q: '¿Me van a llenar el correo de publicidad?',
    a: 'No. Es una vez al mes y buena parte del contenido es material que sirve aunque nunca nos contrates. Si un mes hay algo con condiciones especiales, lo decimos claro y sin vueltas.',
  },
  {
    q: '¿Cómo me doy de baja?',
    a: 'Respondés el correo con la palabra BAJA y te sacamos de la lista. No hay que dar explicaciones. Cada edición lo recuerda al final.',
  },
  {
    q: '¿Comparten mi correo con alguien?',
    a: 'No. Tu correo se guarda en nuestra cuenta de correo y no se vende, alquila ni cede a terceros. El boletín sale con los destinatarios en copia oculta, así que nadie ve el correo de los demás. Está explicado en la política de privacidad.',
  },
];

const schemas = [
  webPageSchema({ path, name: title, description }),
  breadcrumbSchema(crumbs),
  faqSchema(faqs),
];

/** Los artículos más recientes: es una muestra concreta del tipo de contenido. */
const muestra = [...articles].sort((a, b) => b.published.localeCompare(a.published)).slice(0, 3);
const proximaEdicion = ediciones.length > 0;
---
<Base title={title} description={description} path={path} schemas={schemas}>
  <div class="page-wrap">
    <Breadcrumbs items={crumbs} />

    <section class="page-hero">
      <div class="page-hero-inner">
        <span class="page-eyebrow">{promesa.frecuencia} · Sin spam</span>
        <h1 class="page-h1">El boletín mensual de HacksinCodigos</h1>
        <p class="page-lead">
          Un correo al mes con lo nuevo que publicamos, un caso real de un cliente y una
          recomendación que podés aplicar sin contratarnos. Se lee en tres minutos.
        </p>
      </div>
    </section>

    <NewsletterSignup
      variante="bloque"
      titulo="Dejanos tu correo"
      texto="Te llega la próxima edición y ninguna otra cosa. Para salir, respondés BAJA."
    />

    <section class="section-block">
      <div class="section-inner narrow prose">
        <h2>Qué vas a recibir</h2>
        <ul>
          {promesa.incluye.map((i) => <li>{i}</li>)}
        </ul>

        <h2>Qué no va a pasar</h2>
        <ul>
          {promesa.noIncluye.map((i) => <li>{i}</li>)}
        </ul>

        <h2>Para quién es</h2>
        <p>
          Para dueños y encargados de negocios en Costa Rica que quieren estar al tanto de lo
          que se puede hacer con su presencia digital sin tener que investigarlo por su cuenta.
          También para clientes nuestros que quieren saber qué servicios nuevos hay disponibles
          antes de que se los ofrezcamos.
        </p>
        <p>
          Si ya trabajás con nosotros, el boletín es la forma más simple de enterarte de que
          existe algo que te sirve. Pasa seguido que un cliente necesita algo que ya hacemos y
          no lo sabe.
        </p>
      </div>
    </section>

    <section class="section-block alt">
      <div class="section-inner">
        <h2 class="block-title">El tipo de contenido que mandamos</h2>
        <p class="block-sub">
          Estos artículos ya están publicados y son una muestra de lo que llega al correo.
        </p>
        <div class="card-grid cols-3">
          {muestra.map((a) => (
            <a class="info-card" href={`/blog/${a.slug}/`}>
              <span class="blog-tag" style={`color:${a.tagColor}`}>{a.tag}</span>
              <h3 style="margin-top:.5rem">{a.title}</h3>
              <p>{a.excerpt}</p>
            </a>
          ))}
        </div>
      </div>
    </section>

    {proximaEdicion && (
      <section class="section-block">
        <div class="section-inner narrow prose">
          <h2>Sobre tus datos</h2>
          <p>
            Solo pedimos el correo. No hace falta nombre, teléfono ni empresa para suscribirse.
            El correo se guarda en nuestra cuenta de correo para poder mandarte el boletín, y
            no se comparte con nadie más. El envío sale con los destinatarios en copia oculta,
            así que nadie ve el correo de los demás. Podés pedirnos que lo borremos cuando
            querás, o responder BAJA a cualquier edición.
            El detalle está en la <a href="/politica-de-privacidad/">política de privacidad</a>.
          </p>
        </div>
      </section>
    )}

    <section class="section-block alt">
      <div class="section-inner narrow">
        <h2 class="block-title">Preguntas frecuentes</h2>
        <div class="faq-list" style="margin-top:1.5rem">
          {faqs.map((f) => (
            <div class="faq-item">
              <button class="faq-question" aria-expanded="false">
                <span>{f.q}</span>
                <svg class="faq-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><line x1="12" y1="5" x2="12" y2="19"/><line x1="5" y1="12" x2="19" y2="12"/></svg>
              </button>
              <div class="faq-answer"><p>{f.a}</p></div>
            </div>
          ))}
        </div>
      </div>
    </section>
  </div>
</Base>
