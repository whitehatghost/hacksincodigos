---
import Base from '../../layouts/Base.astro';
import Breadcrumbs from '../../components/Breadcrumbs.astro';
import CtaBand from '../../components/CtaBand.astro';
import WhatsAppIcon from '../../components/WhatsAppIcon.astro';
import { products, productsOf, type Product } from '../../data/products';
import { categories } from '../../data/shop';
import Price from '../../components/Price.astro';
import { wa, payment } from '../../data/site';
import { webPageSchema, breadcrumbSchema, productSchema } from '../../lib/schema';

export function getStaticPaths() {
  return products.map((p) => ({ params: { slug: p.slug }, props: { product: p } }));
}

interface Props { product: Product }
const { product } = Astro.props;
const path = `/product/${product.slug}/`;

const crumbs = [
  { name: 'Inicio', path: '/' },
  { name: 'Precios', path: '/shop/' },
  { name: product.title, path },
];

const category = categories.find((c) => c.id === product.category);
const related = productsOf(product.category).filter((p) => p.slug !== product.slug).slice(0, 4);

const schemas = [
  webPageSchema({ path, name: product.metaTitle, description: product.metaDesc, type: 'ItemPage' }),
  breadcrumbSchema(crumbs),
  productSchema({
    name: product.title,
    description: product.shortDesc || product.title,
    path,
    // Sin precio fijo no se emite `Offer`: publicar un precio inventado en el
    // Schema es motivo de acción manual por parte de Google.
    price: product.price === null ? null : String(product.price),
    sku: product.sku || undefined,
    image: product.image,
  }),
];

const waMessage =
  product.price === null
    ? `Hola, me interesa ${product.title}. ¿Me pasás una cotización?`
    : `Hola, me interesa ${product.title} (${product.priceLabel} USD). ¿Me das más información?`;
---
<Base
  title={product.metaTitle}
  description={product.metaDesc}
  path={path}
  image={product.image}
  type="product"
  schemas={schemas}
>
  <div class="page-wrap">
    <Breadcrumbs items={crumbs} />

    <section class="section-block">
      <div class="section-inner">
        <div class="product-layout">
          <div class="product-gallery">
            <img
              src={product.image}
              alt={product.title}
              width="800"
              height="800"
              fetchpriority="high"
              decoding="async"
            />
          </div>

          <div class="product-summary">
            {category && <span class="page-eyebrow" style="margin-bottom:.9rem">{category.title}</span>}
            <h1>{product.title}</h1>

            <Price price={product.price} unit={product.unit} />

            {product.tagline && (
              <p class="page-lead" style="text-align:left;margin:.35rem 0 1.25rem">{product.tagline}</p>
            )}

            {product.highlights.length > 0 && (
              <ul class="plan-features" role="list" style="margin-bottom:1.25rem">
                {product.highlights.map((h) => <li>{h}</li>)}
              </ul>
            )}

            <div class="page-cta-row" style="justify-content:flex-start;margin-top:0">
              <a href={wa(waMessage)} class="btn btn-solid wa-btn" target="_blank" rel="noopener">
                <WhatsAppIcon size={18} />
                <span>Pedir por WhatsApp</span>
              </a>
              <a href="/shop/" class="btn btn-outline">Ver todos los precios</a>
            </div>

            <div class="product-order-note">
              Conversamos el alcance por WhatsApp y te pasamos la cotización. El pago se hace
              por <strong>{payment.label}</strong>. {payment.currencyNote}
            </div>

            <dl class="product-meta">
              {product.sku && <div><dt style="display:inline">SKU:</dt> <dd style="display:inline">{product.sku}</dd></div>}
              {category && (
                <div>
                  <dt style="display:inline">Categoría:</dt>{' '}
                  <dd style="display:inline">
                    <a href={`/shop/#${category.id}`} style="color:var(--accent-green);text-decoration:none">{category.title}</a>
                  </dd>
                </div>
              )}
            </dl>
          </div>
        </div>
      </div>
    </section>

    {product.descHtml && (
      <section class="section-block alt">
        <div class="section-inner narrow">
          <h2 class="block-title">Qué incluye</h2>
          <div class="prose" set:html={product.descHtml} />
        </div>
      </section>
    )}

    {related.length > 0 && (
      <section class="section-block">
        <div class="section-inner">
          <h2 class="block-title">{category ? category.title : 'Otros servicios'}</h2>
          <p class="block-sub">Más opciones de la misma categoría.</p>
          <div class="catalog-grid">
            {related.map((p) => (
              <article class="catalog-card">
                <a href={`/product/${p.slug}/`} class="catalog-media" tabindex="-1" aria-hidden="true">
                  <img src={p.imageSmall} alt="" width="400" height="400" loading="lazy" decoding="async" />
                </a>
                <div class="catalog-body">
                  <h3><a href={`/product/${p.slug}/`}>{p.title}</a></h3>
                  <Price price={p.price} unit={p.unit} size="sm" />
                </div>
              </article>
            ))}
          </div>
        </div>
      </section>
    )}

    <CtaBand waText={waMessage} />
  </div>
</Base>
