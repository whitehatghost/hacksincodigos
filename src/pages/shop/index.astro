---
import Base from '../../layouts/Base.astro';
import Breadcrumbs from '../../components/Breadcrumbs.astro';
import CtaBand from '../../components/CtaBand.astro';
import WhatsAppIcon from '../../components/WhatsAppIcon.astro';
import { categories } from '../../data/shop';
import { products, productsOf, waFor } from '../../data/products';
import { webPageSchema, breadcrumbSchema } from '../../lib/schema';

const title = 'Servicios de Desarrollo Web y Software en Costa Rica';
const description =
  'Páginas web, tiendas online, software a la medida para PYMES, CRM empresarial, apps, mantenimiento y contenido para redes. Cotización sin compromiso por WhatsApp.';

const crumbs = [
  { name: 'Inicio', path: '/' },
  { name: 'Servicios', path: '/shop/' },
];

const schemas = [
  webPageSchema({ path: '/shop/', name: title, description, type: 'CollectionPage' }),
  breadcrumbSchema(crumbs),
  {
    '@context': 'https://schema.org',
    '@type': 'ItemList',
    name: 'Servicios de HacksinCodigos',
    numberOfItems: products.length,
    itemListElement: products.map((p, i) => ({
      '@type': 'ListItem',
      position: i + 1,
      name: p.title,
      url: `https://hacksincodigos.com/product/${p.slug}/`,
    })),
  },
];
---
<Base title={`${title} | HacksinCodigos`} description={description} path="/shop/" schemas={schemas}>
  <div class="page-wrap">
    <Breadcrumbs items={crumbs} />

    <section class="page-hero">
      <div class="page-hero-inner">
        <span class="page-eyebrow">Catálogo de servicios</span>
        <h1 class="page-h1">Todo lo que hacemos</h1>
        <p class="page-lead">
          Cada proyecto tiene un alcance distinto, así que cotizamos caso por caso en vez de
          publicar una lista de precios que casi nunca calza. Escribinos por WhatsApp, nos contás
          qué necesitás y te pasamos una propuesta con todo detallado — sin compromiso.
        </p>
        <div class="page-cta-row">
          <a
            href={waFor('Hola, quiero cotizar un proyecto con ustedes')}
            class="btn btn-solid wa-btn"
            target="_blank"
            rel="noopener"
          >
            <WhatsAppIcon size={18} />
            <span>Pedir cotización</span>
          </a>
          <a href="/proyectos/" class="btn btn-outline">Ver proyectos</a>
        </div>
      </div>
    </section>

    {categories.map((cat, idx) => {
      const list = productsOf(cat.id);
      if (!list.length) return null;

      // 'featured' y 'plans' muestran tarjetas grandes con lo que incluye cada opción;
      // 'grid' es la cuadrícula compacta con imagen para los servicios más puntuales.
      const big = cat.layout === 'featured' || cat.layout === 'plans';

      return (
        <section class:list={['section-block', idx % 2 === 1 && 'alt']} id={cat.id}>
          <div class="section-inner">
            <h2 class="block-title">{cat.title}</h2>
            <p class="block-sub">{cat.intro}</p>

            <div class:list={[
              cat.layout === 'featured' ? 'plan-duo' : cat.layout === 'plans' ? 'plan-row' : 'catalog-grid',
            ]}>
              {list.map((p) => big ? (
                <article class:list={['plan-card', p.recommended && 'is-recommended']}>
                  {p.recommended && <span class="plan-flag">Más pedido</span>}
                  <h3 class="plan-name"><a href={`/product/${p.slug}/`}>{p.title}</a></h3>
                  <p class="plan-tagline">{p.tagline}</p>
                  {p.highlights.length > 0 && (
                    <ul class="plan-features" role="list">
                      {p.highlights.map((h) => <li>{h}</li>)}
                    </ul>
                  )}
                  <div class="plan-actions">
                    <a href={waFor(p)} class="btn btn-solid wa-btn" target="_blank" rel="noopener">
                      <WhatsAppIcon size={17} />
                      <span>Cotizar</span>
                    </a>
                    <a href={`/product/${p.slug}/`} class="plan-detail">Ver qué incluye →</a>
                  </div>
                </article>
              ) : (
                <article class="catalog-card">
                  <a href={`/product/${p.slug}/`} class="catalog-media" tabindex="-1" aria-hidden="true">
                    <img src={p.imageSmall} alt="" width="400" height="400" loading="lazy" decoding="async" />
                  </a>
                  <div class="catalog-body">
                    <h3><a href={`/product/${p.slug}/`}>{p.title}</a></h3>
                    <p class="catalog-tagline">{p.tagline}</p>
                    <div class="catalog-actions">
                      <a href={waFor(p)} class="btn-consult" target="_blank" rel="noopener">Cotizar →</a>
                      <a href={`/product/${p.slug}/`} class="service-more">Detalles</a>
                    </div>
                  </div>
                </article>
              ))}
            </div>
          </div>
        </section>
      );
    })}

    <section class="section-block alt">
      <div class="section-inner narrow prose">
        <h2>Cómo cotizamos</h2>
        <ol>
          <li>Escribinos por WhatsApp y contanos qué necesitás. No hace falta que lo tengás
          todo definido — con la idea general alcanza para empezar.</li>
          <li>Conversamos el alcance: qué entra, qué no, y qué conviene dejar para una
          segunda etapa.</li>
          <li>Te pasamos una propuesta por escrito con el detalle, el plazo y el precio
          cerrado.</li>
          <li>Si te calza, arrancamos. Si no, no pasa nada — la cotización no compromete
          a nada.</li>
        </ol>

        <h2>Por qué no publicamos precios</h2>
        <p>
          Porque el mismo servicio cuesta distinto según el caso. Una página web para un
          negocio con cuatro secciones y textos listos no es el mismo trabajo que una con
          treinta y contenido por redactar. Publicar un número obliga a inventar un promedio
          que a unos les queda caro y a otros barato.
        </p>
        <p>
          Preferimos mirar tu caso y darte un número que se sostenga. La cotización es
          gratis y llega con todo desglosado.
        </p>

        <h2>Formas de pago</h2>
        <p>
          SINPE Móvil o transferencia bancaria. Los datos se envían junto con la
          cotización. Los proyectos de desarrollo normalmente llevan un adelanto para
          iniciar y el saldo contra entrega.
        </p>
      </div>
    </section>

    <CtaBand
      title="¿Empezamos por tu caso?"
      text="Contanos qué necesita tu negocio y te decimos qué conviene hacer — incluso si la respuesta es que necesitás menos de lo que pensabas."
      waText="Hola, quiero cotizar un proyecto con ustedes"
    />
  </div>
</Base>
