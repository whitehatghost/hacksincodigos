import ServiceLanding from '../layouts/ServiceLanding.astro';
import Partners from '../components/Partners.astro';

const path = '/software-a-la-medida-costa-rica/';

const faqs = [
  {
    q: '¿Qué es un software a la medida?',
    a: 'Es un sistema construido para el proceso de un negocio en particular, en lugar de una plataforma genérica a la que hay que adaptarse. Se parte de cómo trabaja la empresa hoy — qué se registra, quién aprueba qué, qué reportes hacen falta — y sobre eso se programa.',
  },
  {
    q: '¿Qué es un CRM empresarial y para qué sirve?',
    a: 'Un CRM (Customer Relationship Management) centraliza todo lo que pasa con cada cliente: quién es, qué pidió, qué se le cotizó, quién lo atendió y cuándo hay que darle seguimiento. Sirve para que la información deje de vivir en el celular de un vendedor y para que ninguna cotización se quede sin respuesta.',
  },
  {
    q: '¿Conviene un CRM a medida o uno ya hecho?',
    a: 'Depende. Si tu proceso comercial es estándar, configurar bien una plataforma establecida sale más a cuenta y se arranca más rápido. El desarrollo a medida se justifica cuando el proceso tiene reglas propias que ninguna plataforma cubre, cuando hay que integrarlo con sistemas que ya existen, o cuando el costo por usuario al mes deja de tener sentido. En el diagnóstico te decimos cuál de los dos caminos te conviene, aunque sea el que no nos contrata.',
  },
  {
    q: '¿Cuánto cuesta desarrollar un software a la medida?',
    a: 'Se cotiza por alcance. No hay precio de lista porque no hay dos negocios con el mismo proceso: el costo depende de cuántos módulos lleve, cuántos tipos de usuario haya y con qué otros sistemas tenga que conectarse. Casi siempre conviene arrancar con un módulo acotado y crecer desde ahí.',
  },
  {
    q: '¿El código y los datos quedan míos?',
    a: 'Sí. Al completarse el pago, el código, la base de datos y los accesos quedan a nombre del cliente. Podés seguir el mantenimiento con nosotros o con quien quieras.',
  },
  {
    q: '¿Cuánto tarda un proyecto de este tipo?',
    a: 'Un módulo acotado puede estar funcionando en semanas; un sistema con varios módulos y usuarios toma meses. Entregamos por partes en lugar de todo al final, para que el equipo empiece a usar lo primero mientras se construye lo siguiente.',
  },
  {
    q: '¿Se puede usar desde el celular?',
    a: 'Sí. Los sistemas se construyen para funcionar en navegador y adaptarse al teléfono, que es donde suele estar el vendedor, el técnico o el encargado de bodega. Cuando el caso lo pide, se desarrolla además una aplicación móvil.',
  },
];

const soluciones = [
  {
    n: '01',
    t: 'CRM empresarial',
    d: 'Clientes, cotizaciones, seguimiento y responsables en un solo lugar. Para que nadie se quede sin respuesta y el historial no dependa de la memoria de quien atendió.',
    href: '/product/crm-empresarial/',
  },
  {
    n: '02',
    t: 'Sistemas de gestión',
    d: 'Inventario, bodega, facturación, pedidos y despachos. El reemplazo de las hojas de cálculo sueltas que hoy nadie sabe cuál es la buena.',
    href: '/product/software-a-la-medida-pymes/',
  },
  {
    n: '03',
    t: 'Aplicaciones móviles y web',
    d: 'Apps para Android, iOS y navegador cuando el trabajo pasa fuera del escritorio: en ruta, en obra o en el punto de venta.',
    href: '/product/aplicaciones-moviles-y-web/',
  },
  {
    n: '04',
    t: 'Integraciones y APIs',
    d: 'Conectar el sistema con lo que ya usás: la tienda en línea, la contabilidad, WhatsApp, la pasarela de pagos o el ERP del proveedor.',
    href: '/desarrollo-web-costa-rica/',
  },
  {
    n: '05',
    t: 'Paneles y reportes',
    d: 'Los números del negocio calculados solos, no armados a mano cada fin de mes. Con los indicadores que a la gerencia realmente le sirven.',
  },
  {
    n: '06',
    t: 'Portales para clientes',
    d: 'Un área privada donde el cliente consulta su estado de cuenta, sus pedidos o sus documentos sin tener que llamar a preguntar.',
  },
];

const etapas = [
  {
    n: '01',
    t: 'Entender el proceso real',
    d: 'Antes de programar nada nos sentamos a ver cómo trabaja el equipo hoy: qué se anota, dónde, quién lo revisa y en qué punto se pierde la información.',
  },
  {
    n: '02',
    t: 'Definir el alcance',
    d: 'Se decide qué se automatiza y qué conviene dejar manual. Todo automatizado suena bien y sale caro; lo que importa es atacar el cuello de botella.',
  },
  {
    n: '03',
    t: 'Construir por módulos',
    d: 'Se entrega por partes. El equipo empieza a usar el primer módulo mientras se desarrolla el siguiente, y ese uso corrige el rumbo antes de que salga caro corregirlo.',
  },
  {
    n: '04',
    t: 'Capacitar y acompañar',
    d: 'Un sistema que nadie sabe usar no sirve. Se capacita al equipo, se ajusta lo que estorba y se acompaña las primeras semanas de operación.',
  },
